# ─── RevoTech environment ────────────────────────────────────────────────────
# Copy to .env.local and edit. .env.local is gitignored; this file is committed
# and must never hold a real secret.

# ─── This app (Next.js) ──────────────────────────────────────────────────────
# The backend: the Flask API (Module 2). Server-only - used by Server Components
# and as the target of the /api rewrite in next.config.ts. Default: a local
# `waitress-serve --port=5000 app:app`.
#   production: BACKEND_URL=https://revotech-m2.vercel.app
BACKEND_URL=http://localhost:5000

# Where the browser sends its API calls. Keep "/api": next.config.ts proxies it
# to BACKEND_URL, so the browser never calls another origin (no CORS needed).
# Never put a database URL in a NEXT_PUBLIC_ variable - anything with that
# prefix is compiled into the JavaScript every visitor downloads.
NEXT_PUBLIC_API_BASE_URL=/api

# Sent as x-api-key on server-side fetches. Server-only — never give a secret
# the NEXT_PUBLIC_ prefix, or it ends up in the browser bundle.
API_SECRET_KEY=dev-only-change-me

# Product image uploads. Unset = saved in .data/uploads (development). Set =
# Vercel Blob (Vercel → Storage → Blob → connect to the project, which adds
# this variable for you). Only the three converted AVIFs are stored; the
# original upload is never kept, and unused uploads are deleted.
# BLOB_READ_WRITE_TOKEN=

# Optional. Uncomment and restart `npm run dev`:
# UPLOAD_ORPHAN_GRACE_MINUTES=60  delete unused product uploads after this long
# PORT=9000                       dev/start port (npm scripts already pass 9000)

# ─── Module 2 backend: Flask + PostgreSQL ────────────────────────────────────
# Not read by this app. These go in the Flask project's own .env — and the
# same host/port/database/user/password in DBeaver to browse the data.
# (README → "Database access (DBeaver)".) For Supabase: the session pooler
# host (aws-0-<region>.pooler.supabase.com), port 5432, database postgres,
# user postgres.<project-ref>, SSL required.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revoshop_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# The Flask app reads the whole connection as one URL (DATABASE_URL in its
# .env). On Supabase append ?sslmode=require. TEST_DATABASE_URL is a separate
# local database for pytest - never the real one.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/revoshop_db
TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/revoshop_test_db
SQLALCHEMY_TRACK_MODIFICATIONS=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Flask
FLASK_APP=app.py
FLASK_DEBUG=1
# signs the JWT access tokens: long and random in production
SECRET_KEY=change-me

# Gunicorn — production server on a Linux host (Vercel runs the WSGI app itself):
#   gunicorn --bind $GUNICORN_BIND --workers $GUNICORN_WORKERS "app:app"
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
